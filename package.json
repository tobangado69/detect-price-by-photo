{
    "name": "detect-price-by-photo",
    "version": "0.0.0",
    "private": true,
    "scripts": {
        "prepare": "moon setup",
        "lint": "moon :lint",
        "check": "moon :check",
        "format": "biome format . --write",
        "dev:backend": "moon run backend:dev",
        "dev:frontend": "moon run frontend:dev",
        "test:backend": "moon run backend:test",
        "test:frontend": "moon run frontend:test",
        "build:backend": "moon run backend:build",
        "build:frontend": "moon run frontend:build",
        "build:all": "moon :build",
        "typecheck": "moon :typecheck",
        "compose:cleanup": "docker compose -f compose.yaml down --remove-orphans --volumes",
        "compose:up": "docker compose -f compose.yaml up -d --remove-orphans",
        "compose:down": "docker compose -f compose.yaml down --remove-orphans",
        "compose:reset": "docker compose -f compose.yaml down --remove-orphans --volumes",
        "update-deps": "npm-check-updates --configFileName .ncurc.json && moon :update-deps",
        "cleanup": "pnpm --stream --color \"/cleanup:(?!deps|cache)/\"",
        "cleanup:deps": "pnpm dlx del-cli pnpm-lock.yaml node_modules",
        "cleanup:cache": "pnpm dlx del-cli .moon/cache --verbose",
        "cleanup:apps": "pnpm run -r --stream --color cleanup",
        "cleanup:store": "pnpm store prune --force",
        "moon:sync": "moon sync",
        "moon:check": "moon check"
    },
    "devDependencies": {
        "@biomejs/biome": "catalog:",
        "npm-check-updates": "catalog:"
    },
    "pnpm": {
        "onlyBuiltDependencies": [
            "@biomejs/biome",
            "@swc/core",
            "core-js-pure",
            "esbuild",
            "sharp"
        ]
    },
    "packageManager": "pnpm@10.18.0"
}
