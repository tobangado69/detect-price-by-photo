# Moonrepo ignore patterns
# Files and directories to exclude from Moonrepo operations

# Dependencies
node_modules/
**/node_modules/
.pnpm-store/

# Build outputs
dist/
build/
bin/
**/dist/
**/build/
**/bin/
*.exe

# Logs
*.log
logs/
**/logs/

# Environment files
.env
.env.local
.env.*.local
**/.env

# IDE
.vscode/
.idea/
*.swp
*.swo
*~

# OS
.DS_Store
Thumbs.db

# Docker
docker-compose.override.yml

# Test outputs
coverage/
.nyc_output/
**/coverage/

# Temporary files
tmp/
temp/
**/tmp/
**/temp/

# Lock files (Moonrepo manages these)
pnpm-lock.yaml
package-lock.json
yarn.lock

