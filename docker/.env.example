# Detect Price by Photo - Environment Variables Example
# Copy this file to docker/.env.dev and fill in your actual values
# NEVER commit docker/.env.dev to version control

# ============================================
# Database Configuration
# ============================================
DATABASE_URL=postgresql://postgres:postgres@db:5432/detect_price?sslmode=disable
POSTGRES_DB=detect_price
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres

# ============================================
# Redis Configuration
# ============================================
REDIS_URL=redis://localhost:6379

# ============================================
# Application Configuration
# ============================================
APP_MODE=development
APP_BASE_URL=http://localhost:5173
SERVER_HOST=0.0.0.0
SERVER_PORT=8000

# ============================================
# JWT Configuration
# ============================================
# REQUIRED: Generate a secure random secret (minimum 32 characters)
# Example: openssl rand -base64 32
JWT_SECRET_KEY=CHANGE_THIS_TO_A_SECURE_RANDOM_STRING_MIN_32_CHARS
JWT_ALGORITHM=HS256

# ============================================
# SMTP / Email Configuration
# ============================================
SMTP_HOST=mailhog
SMTP_PORT=1025
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_SENDER_NAME=Detect Price by Photo
SMTP_SENDER_EMAIL=noreply@detectprice.local
SMTP_SECURE=false

# ============================================
# Midtrans Payment Gateway
# ============================================
# REQUIRED: Get credentials from https://dashboard.midtrans.com/
# Sandbox: https://dashboard.sandbox.midtrans.com/
MIDTRANS_SERVER_KEY=YOUR_MIDTRANS_SERVER_KEY_HERE
MIDTRANS_CLIENT_KEY=YOUR_MIDTRANS_CLIENT_KEY_HERE
MIDTRANS_ENV=sandbox
MIDTRANS_MERCHANT_ID=YOUR_MERCHANT_ID_HERE

# ============================================
# OpenRouter AI Service
# ============================================
# Optional: Get API key from https://openrouter.ai/
OPENROUTER_API_KEY=YOUR_OPENROUTER_API_KEY_HERE
AI_DEFAULT_MODEL=openai/gpt-4o-mini
AI_ALLOWED_MODELS=openai/gpt-4o-mini,anthropic/claude-3-5-haiku
AI_MODE_ROUTING=fast:openai/gpt-4o-mini|accurate:anthropic/claude-3-5-haiku

# ============================================
# AWS S3 Storage (Optional)
# ============================================
PUBLIC_ASSETS_URL=http://localhost:8010
S3_ENDPOINT=http://localhost:9100
S3_ACCESS_KEY=s3admin
S3_SECRET_KEY=s3passw0rd
S3_BUCKET_NAME=devbucket
S3_REGION=auto
S3_FORCE_PATH_STYLE=false
S3_USE_SSL=false

# ============================================
# Observability (Optional)
# ============================================
OTEL_SERVICE_NAME=detect-price-backend
OTEL_EXPORTER_OTLP_PROTOCOL=http/protobuf
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
OTEL_EXPORTER_OTLP_HEADERS=
OTEL_ENABLE_TELEMETRY=false
OTEL_INSECURE_MODE=true
OTEL_TRACING_SAMPLE_RATE=0.7

# ============================================
# CORS Configuration
# ============================================
CORS_ORIGINS=http://localhost:5173,http://localhost:3000
CORS_MAX_AGE=300
CORS_CREDENTIALS=true

# ============================================
# Rate Limiting
# ============================================
RATE_LIMIT_ENABLED=true
RATE_LIMIT_REQUESTS=20
RATE_LIMIT_BURST_SIZE=60

# ============================================
# Logging
# ============================================
LOG_LEVEL=info
LOG_FORMAT=pretty
LOG_NO_COLOR=false

# ============================================
# Database Connection Pool
# ============================================
PG_MAX_POOL_SIZE=10
PG_MAX_RETRIES=5

# ============================================
# Redis Configuration
# ============================================
REDIS_ENABLED=true
REDIS_DB=0

# ============================================
# API Documentation
# ============================================
ENABLE_API_DOCS=true

# ============================================
# pgweb Configuration (Optional)
# ============================================
PGWEB_PORT=8081
